<Page x:Class="UWPCloudPlayer.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="18,0">
                <TextBlock Text="樊老师网课播放器" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button Content="打开视频" Click="OpenButton_Click" />
                    <Button Content="打开局域网文件夹" Click="OpenSmbButton_Click" />
                    <Button Content="收藏当前文件夹" Click="FavoriteFolderButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="我的内容" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="4,2,4,12" />
                    <TextBlock Text="收藏文件夹" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,4" />
                    <ListView x:Name="FavoritesList" SelectionChanged="FavoritesList_SelectionChanged" />
                    <TextBlock Text="播放列表" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,14,4,4" />
                    <ListView x:Name="PlaylistList" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#000000" CornerRadius="8" Clip="{x:Null}">
                <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <TextBlock Text="护眼" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="色温" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Slider x:Name="TemperatureSlider" Width="150" Minimum="-100" Maximum="100" Value="0" ValueChanged="TemperatureSlider_ValueChanged" />
                    <Button Content="反色" Click="InvertButton_Click" />
                    <Button Content="裁切" Click="CropButton_Click" />
                    <Button Content="全屏" Click="FullscreenButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
